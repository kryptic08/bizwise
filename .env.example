CONVEX_DEPLOYMENT=dev:your-team-123 # You'll get this after running `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=https://your-convex-deployment-url
EXPO_PUBLIC_OCR_API_KEY=K87899142388957
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Round-robin keys for OCR / receipt scanning
EXPO_PUBLIC_GEMINI_API_KEY_1=your-gemini-api-key-1
EXPO_PUBLIC_GEMINI_API_KEY_2=your-gemini-api-key-2
EXPO_PUBLIC_GEMINI_API_KEY_3=your-gemini-api-key-3

# Optional: comma-separated model rotation order used by Add Expenses parser
EXPO_PUBLIC_GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.0-flash

# Optional: set to true to force verbose Gemini attempt logs outside __DEV__
EXPO_PUBLIC_GEMINI_DEBUG=true

# Dedicated keys for AI auto-categorization (manual entry) — kept separate from OCR quota
EXPO_PUBLIC_GEMINI_CATEGORY_KEY_1=your-category-api-key-1
EXPO_PUBLIC_GEMINI_CATEGORY_KEY_2=your-category-api-key-2
EXPO_PUBLIC_GEMINI_CATEGORY_KEY_3=your-category-api-key-3